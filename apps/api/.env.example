# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://trippilot:trippilot@localhost:5432/trippilot?schema=public

# ── Redis (background jobs / caching — used from Milestone 3) ──
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────
# Use a long random string in every non-local environment: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7

# ── AI provider ─────────────────────────────────────────
# sample  = deterministic rule-based planner over sample data (Milestone 1)
# gemini  = Google Gemini (Milestone 2; requires GEMINI_API_KEY)
AI_PROVIDER=sample
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Data providers (Milestone 2+) — keys live only on the server ──
MAPS_PROVIDER=none
MAPS_API_KEY=
FLIGHT_PROVIDER=estimate
FLIGHT_PROVIDER_API_KEY=
HOTEL_PROVIDER=estimate
HOTEL_PROVIDER_API_KEY=
FX_PROVIDER=sample
FX_PROVIDER_API_KEY=
WEATHER_PROVIDER=none
WEATHER_API_KEY=
